# Copie para .env e troque as senhas. Nunca versione o .env.
POSTGRES_PASSWORD=troque-esta-senha

# PK-01 usa o usuário de bootstrap; o PK-02 troca pelo papel dbwatch_app (menor privilégio)
DATABASE_URL=postgres://postgres:troque-esta-senha@127.0.0.1:5432/dbwatch
TEST_DATABASE_URL=postgres://postgres:troque-esta-senha@127.0.0.1:5433/dbwatch_test

API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1
