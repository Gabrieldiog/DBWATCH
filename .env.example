# Copie para .env e troque as senhas. Nunca versione o .env.
POSTGRES_PASSWORD=troque-esta-senha

# Uma senha por papel do banco (docs/DATA_MODEL.md §5)
DBWATCH_MIGRATOR_PASSWORD=troque-migrator
DBWATCH_APP_PASSWORD=troque-app
DBWATCH_MONITOR_PASSWORD=troque-monitor
DBWATCH_LAB_PASSWORD=troque-lab
DBWATCH_TARGET_RO_PASSWORD=troque-target

# A API roda com o papel de menor privilégio; só as migrations usam o migrator
DATABASE_URL=postgres://dbwatch_app:troque-app@127.0.0.1:5432/dbwatch
MIGRATOR_DATABASE_URL=postgres://dbwatch_migrator:troque-migrator@127.0.0.1:5432/dbwatch

# Banco de testes (superusuário só para preparar e inspecionar; os testes usam os papéis)
TEST_DATABASE_URL=postgres://postgres:troque-esta-senha@127.0.0.1:5433/dbwatch_test

API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1

# Origem do front: requisições que alteram estado (POST etc.) só são aceitas vindas daqui
APP_ORIGIN=http://localhost:3000
# Tentativas de login por IP por minuto
LOGIN_RATE_LIMIT=20
# Documentação interativa em /api/docs (on/off)
API_DOCS=on
# Intervalo, em segundos, do job que audita expirações de acesso (0 desliga)
GRANT_SWEEP_SECONDS=30
# Banco-alvo das consultas controladas, com o papel somente leitura
TARGET_DATABASE_URL=postgres://dbwatch_target_ro:troque-target@127.0.0.1:5432/dbwatch_target
# Coletor do monitor (papel dbwatch_monitor, membro de pg_monitor) e intervalo entre amostras
MONITOR_DATABASE_URL=postgres://dbwatch_monitor:troque-monitor@127.0.0.1:5432/dbwatch
MONITOR_SAMPLE_SECONDS=5
# Limites dos alertas do monitor (ms): espera por lock e transação parada
MONITOR_LOCK_ALERT_MS=5000
MONITOR_IDLE_ALERT_MS=30000
# LAB: laboratório de concorrência (papel dbwatch_lab); deixe false em produção se não for demonstrar
LAB_ENABLED=false
LAB_DATABASE_URL=postgres://dbwatch_lab:troque-lab@127.0.0.1:5432/dbwatch
