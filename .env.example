# Copie para .env e troque as senhas. Nunca versione o .env.
POSTGRES_PASSWORD=troque-esta-senha

# Uma senha por papel do banco (docs/DATA_MODEL.md §5)
DBWATCH_MIGRATOR_PASSWORD=troque-migrator
DBWATCH_APP_PASSWORD=troque-app
DBWATCH_MONITOR_PASSWORD=troque-monitor
DBWATCH_LAB_PASSWORD=troque-lab
DBWATCH_TARGET_RO_PASSWORD=troque-target

# A API roda com o papel de menor privilégio; só as migrations usam o migrator
DATABASE_URL=postgres://dbwatch_app:troque-app@127.0.0.1:5432/dbwatch
MIGRATOR_DATABASE_URL=postgres://dbwatch_migrator:troque-migrator@127.0.0.1:5432/dbwatch

# Banco de testes (superusuário só para preparar e inspecionar; os testes usam os papéis)
TEST_DATABASE_URL=postgres://postgres:troque-esta-senha@127.0.0.1:5433/dbwatch_test

API_PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
API_HOST=127.0.0.1

# Origem do front: requisições que alteram estado (POST etc.) só são aceitas vindas daqui
APP_ORIGIN=http://localhost:3000
# Tentativas de login por IP por minuto
LOGIN_RATE_LIMIT=20
# Documentação interativa em /api/docs (on/off)
API_DOCS=on
