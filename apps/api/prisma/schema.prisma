generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
  schemas  = ["iam", "pam"]
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
  @@schema("iam")
}

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String
  displayName      String     @map("display_name")
  passwordHash     String     @map("password_hash")
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles            UserRole[] @relation("UserRoles")
  rolesGranted     UserRole[] @relation("RolesGrantedBy")
  sessions         Session[]
  aclRules         LoginAcl[] @relation("AclUser")
  aclCreated       LoginAcl[] @relation("AclCreatedBy")
  requests         AccessRequest[] @relation("Requester")
  decisions        AccessRequest[] @relation("Decider")
  grants           AccessGrant[]   @relation("Grantee")
  firstApprovals   AccessRequest[] @relation("FirstApprover")
  revokedGrants    AccessGrant[]   @relation("Revoker")
  queryExecutions  QueryExecution[]
  breakGlassReviews AccessRequest[] @relation("BreakGlassReviewer")

  @@map("users")
  @@schema("iam")
}

model Role {
  id          Int              @id @db.SmallInt
  code        String           @unique
  name        String
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
  @@schema("iam")
}

model Permission {
  code        String           @id
  description String
  roles       RolePermission[]

  @@map("permissions")
  @@schema("iam")
}

model RolePermission {
  roleId         Int        @map("role_id") @db.SmallInt
  permissionCode String     @map("permission_code")
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
  @@schema("iam")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      Int      @map("role_id") @db.SmallInt
  grantedById String?  @map("granted_by") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(6)
  user        User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy   User?    @relation("RolesGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("iam")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ip         String?   @db.Inet
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("sessions")
  @@schema("iam")
}

enum AclAction {
  ALLOW
  DENY

  @@map("acl_action")
  @@schema("iam")
}

// Regras de login por IP e horário; a de menor prioridade que casar decide (sem regra: permite)
model LoginAcl {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priority    Int       @db.SmallInt
  action      AclAction
  ipRange     String?   @map("ip_range") @db.Inet
  userId      String?   @map("user_id") @db.Uuid
  weekdays    Int[]     @db.SmallInt
  startTime   DateTime? @map("start_time") @db.Time(0)
  endTime     DateTime? @map("end_time") @db.Time(0)
  description String
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?     @relation("AclUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy   User?     @relation("AclCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([ipRange(ops: InetOps)], type: Gist)
  @@index([priority])
  @@map("login_acl")
  @@schema("iam")
}

enum Sensitivity {
  LOW
  MEDIUM
  HIGH

  @@map("sensitivity")
  @@schema("pam")
}

enum AccessLevel {
  READ
  WRITE

  @@map("access_level")
  @@schema("pam")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("request_status")
  @@schema("pam")
}

model Resource {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String          @unique
  databaseName    String          @map("database_name")
  sensitivity     Sensitivity
  maxGrantMinutes Int             @map("max_grant_minutes")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  requests        AccessRequest[]
  grants          AccessGrant[]
  queryTemplates  QueryTemplate[]

  @@map("resources")
  @@schema("pam")
}

model AccessRequest {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId      String        @map("requester_id") @db.Uuid
  resourceId       String        @map("resource_id") @db.Uuid
  accessLevel      AccessLevel   @map("access_level")
  requestedMinutes Int           @map("requested_minutes")
  justification    String
  status           RequestStatus @default(PENDING)
  decidedById      String?       @map("decided_by") @db.Uuid
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz(6)
  decisionNote     String?       @map("decision_note")
  firstApprovedById String?      @map("first_approved_by") @db.Uuid
  firstApprovedAt  DateTime?     @map("first_approved_at") @db.Timestamptz(6)
  breakGlass       Boolean       @default(false) @map("break_glass")
  reviewedById     String?       @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  reviewNote       String?       @map("review_note")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  requester        User          @relation("Requester", fields: [requesterId], references: [id], onDelete: Restrict)
  decidedBy        User?         @relation("Decider", fields: [decidedById], references: [id], onDelete: Restrict)
  firstApprovedBy  User?         @relation("FirstApprover", fields: [firstApprovedById], references: [id], onDelete: Restrict)
  reviewedBy       User?         @relation("BreakGlassReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  resource         Resource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  grant            AccessGrant?

  @@index([requesterId, createdAt(sort: Desc)])
  @@map("access_requests")
  @@schema("pam")
}

// Concessão temporária gerada por um pedido aprovado; o período é fechado-aberto [starts_at, expires_at)
model AccessGrant {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId   String        @unique @map("request_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  resourceId  String        @map("resource_id") @db.Uuid
  accessLevel AccessLevel   @map("access_level")
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(6)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedById String?       @map("revoked_by") @db.Uuid
  revokeReason String?      @map("revoke_reason")
  expiryAuditedAt DateTime? @map("expiry_audited_at") @db.Timestamptz(6)
  request     AccessRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  user        User          @relation("Grantee", fields: [userId], references: [id], onDelete: Restrict)
  revokedBy   User?         @relation("Revoker", fields: [revokedById], references: [id], onDelete: Restrict)
  executions  QueryExecution[]
  resource    Resource      @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@map("access_grants")
  @@schema("pam")
}

// Catálogo de consultas: o SQL vem só de migration; a API não tem rota para criar ou editar SQL (ADR-011)
model QueryTemplate {
  code        String           @id
  resourceId  String           @map("resource_id") @db.Uuid
  accessLevel AccessLevel      @map("access_level")
  title       String
  sqlText     String           @map("sql_text")
  params      Json             @default("[]")
  maxRows     Int              @map("max_rows")
  timeoutMs   Int              @map("timeout_ms")
  resource    Resource         @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  executions  QueryExecution[]

  @@map("query_templates")
  @@schema("pam")
}

model QueryExecution {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateCode String        @map("template_code")
  grantId      String        @map("grant_id") @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  params       Json
  outcome      String
  sqlstate     String?
  rowCount     Int?          @map("row_count")
  durationMs   Int           @map("duration_ms")
  executedAt   DateTime      @default(now()) @map("executed_at") @db.Timestamptz(6)
  template     QueryTemplate @relation(fields: [templateCode], references: [code], onDelete: Restrict)
  grant        AccessGrant   @relation(fields: [grantId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, executedAt(sort: Desc)])
  @@map("query_executions")
  @@schema("pam")
}
