# Modelo do /opt/dbwatch/.env na VPS (chmod 600). Troque cada TROQUE por uma senha forte e única:
#   openssl rand -hex 24
# Use só letras e números nas senhas (hex), para não precisar de URL-encode nas URLs abaixo.
WEB_PORT=8088
APP_ORIGIN=http://IP-DA-VPS:8088
# Etiqueta das imagens (use a data ou o hash do commit; serve para o rollback)
DBWATCH_TAG=local

POSTGRES_PASSWORD=TROQUE
DBWATCH_MIGRATOR_PASSWORD=TROQUE
DBWATCH_APP_PASSWORD=TROQUE
DBWATCH_MONITOR_PASSWORD=TROQUE
DBWATCH_LAB_PASSWORD=TROQUE
DBWATCH_TARGET_RO_PASSWORD=TROQUE

# O host é sempre db (a rede interna do Compose); repita aqui as mesmas senhas de cima
DATABASE_URL=postgres://dbwatch_app:TROQUE@db:5432/dbwatch
MIGRATOR_DATABASE_URL=postgres://dbwatch_migrator:TROQUE@db:5432/dbwatch
TARGET_DATABASE_URL=postgres://dbwatch_target_ro:TROQUE@db:5432/dbwatch_target
MONITOR_DATABASE_URL=postgres://dbwatch_monitor:TROQUE@db:5432/dbwatch
LAB_ENABLED=true
LAB_DATABASE_URL=postgres://dbwatch_lab:TROQUE@db:5432/dbwatch
